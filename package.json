{
  "name": "insta-autodm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute insta-autodm --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute insta-autodm --local --file=schema.sql",
    "test": "node --no-warnings --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
